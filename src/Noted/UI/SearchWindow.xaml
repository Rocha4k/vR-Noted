<Window x:Class="Noted.UI.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOTED"
        Width="520" Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="#1F2226"
        Deactivated="Window_Deactivated">

    <Border BorderThickness="1" BorderBrush="#3A4149">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="Hint" Text="escreve para pesquisar"
                           Foreground="#E6E8EB" Opacity="0.28"
                           FontFamily="Segoe UI" FontSize="18"
                           Margin="6,4,4,8" IsHitTestVisible="False"/>
                <TextBox x:Name="Query"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#E6E8EB" CaretBrush="#E6E8EB"
                         FontFamily="Segoe UI" FontSize="18"
                         Padding="4,4,4,8"
                         TextChanged="Query_TextChanged"
                         PreviewKeyDown="Query_PreviewKeyDown"/>
            </Grid>

            <ListBox x:Name="Results" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#E6E8EB"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,5"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontFamily="Segoe UI" FontSize="13.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Meta}" FontFamily="Segoe UI" FontSize="11"
                                       Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Empty" Grid.Row="1" Visibility="Collapsed"
                       Margin="6,14,6,0" VerticalAlignment="Top"
                       FontFamily="Segoe UI" FontSize="12.5"
                       Foreground="#E6E8EB" Opacity="0.4"
                       TextWrapping="Wrap"
                       Text="Nenhuma nota corresponde. Ctrl+Enter cria uma com este texto."/>

            <TextBlock Grid.Row="2" Margin="4,8,4,0" FontFamily="Segoe UI" FontSize="10.5"
                       Foreground="#E6E8EB" Opacity="0.4"
                       Text="Enter abre  ·  Ctrl+Enter cria nota com este texto  ·  Esc fecha  ·  #tag filtra"/>
        </Grid>
    </Border>
</Window>
