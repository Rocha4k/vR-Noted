<Window x:Class="Noted.UI.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Noted.Markdown"
        Title="NOTED"
        PreviewKeyDown="Window_PreviewKeyDown"
        Width="300" Height="280" MinWidth="180" MinHeight="60"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#FFF6C9">

    <!-- sem isto o dwm desenha a sua moldura por cima da nota: com WindowStyle=None e a
         janela redimensionavel ficavam 6px de branco em cima da barra do titulo.
         GlassFrameThickness=0 tira-a; ResizeBorderThickness mantem o redimensionar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#66000000"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderThickness="1" BorderBrush="#1A000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- barra: arrastar + accoes -->
            <Border x:Name="Bar" Grid.Row="0" Background="#FFE47A"
                    ToolTip="Arrastar para mover  ·  duplo clique enrola a nota"
                    MouseLeftButtonDown="Bar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- nome da nota + tags; a barra vazia era so uma tira de cor -->
                    <Grid Grid.Column="0" Margin="9,0,4,0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleLabel" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="11.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                   Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TagsLabel" Grid.Column="1" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5" FontFamily="Segoe UI" Opacity="0.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,1,2,0">
                        <Button x:Name="PinBtn" Style="{StaticResource BarButton}" Content="^"
                                ToolTip="Sempre por cima  (Ctrl+T)" Click="Pin_Click"/>
                        <Button Style="{StaticResource BarButton}" Content="+"
                                ToolTip="Nova nota  (Ctrl+Shift+N)" Click="New_Click"/>
                        <Button Style="{StaticResource BarButton}" Content="&#x22EF;"
                                ToolTip="Opcoes: cor, opacidade, alerta, tags" Click="Menu_Click"/>
                        <Button Style="{StaticResource BarButton}" Content="&#x2715;"
                                ToolTip="Fechar nota, fica guardada  (Ctrl+W)" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- leitura: markdown renderizado, checkboxes clicaveis -->
            <md:MarkdownView x:Name="Preview" Grid.Row="1"/>

            <!-- escrita: texto cru, aparece ao clicar no preview -->
            <TextBox x:Name="Editor" Grid.Row="1"
                     Visibility="Collapsed"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent"
                     Padding="10,8,10,8"
                     FontFamily="Segoe UI" FontSize="13.5"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="False"
                     TextChanged="Editor_TextChanged"
                     LostKeyboardFocus="Editor_LostKeyboardFocus"
                     PreviewKeyDown="Editor_PreviewKeyDown"/>

            <Border x:Name="RemindBar" Grid.Row="2" Visibility="Collapsed"
                    Background="#18000000" Padding="10,4,10,5">
                <TextBlock x:Name="RemindLabel" FontSize="11" FontFamily="Segoe UI" Opacity="0.7"/>
            </Border>
        </Grid>
    </Border>
</Window>
