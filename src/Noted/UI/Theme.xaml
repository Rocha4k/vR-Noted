<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- mesma paleta escura da barra de formatacao e da paleta de pesquisa -->
    <SolidColorBrush x:Key="MenuBg"     Color="#23262B"/>
    <SolidColorBrush x:Key="MenuEdge"   Color="#3C424B"/>
    <SolidColorBrush x:Key="MenuFg"     Color="#E8EAED"/>
    <SolidColorBrush x:Key="MenuHover"  Color="#343A42"/>
    <SolidColorBrush x:Key="FieldBg"    Color="#2A2E34"/>
    <SolidColorBrush x:Key="FieldEdge"  Color="#454C56"/>
    <SolidColorBrush x:Key="Accent"     Color="#FFE47A"/>
    <SolidColorBrush x:Key="AccentInk"  Color="#2E2A18"/>
    <SolidColorBrush x:Key="Danger"     Color="#FF8A9A"/>
    <SolidColorBrush x:Key="DangerInk"  Color="#3A1119"/>

    <!-- ============ menus ============ -->

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="12,5,12,5" Background="{StaticResource MenuEdge}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource MenuFg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Chrome" Margin="5,1,5,1" CornerRadius="5"
                                Background="Transparent">
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <TextBlock x:Name="Check" Grid.Column="0" Text="&#x2713;"
                                           Visibility="Collapsed" FontSize="12.5"
                                           Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,14,0"/>

                                <TextBlock x:Name="Gesture" Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           FontSize="11" Opacity="0.42"/>

                                <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed"
                                      Data="M0,0 L4,4 L0,8 Z" Fill="{StaticResource MenuFg}"
                                      Opacity="0.55" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- o nome tem de ser PART_Popup: e por ele que o MenuItem do wpf
                             encontra a popup para gerir a abertura e o fecho do submenu.
                             sem margens nenhumas a volta da borda: era a margem de sombra do
                             template original que, com o submenu virado para a esquerda,
                             ficava entre os dois menus como uma faixa transparente. numa
                             popup transparente essa faixa deixa passar o rato, ele aterra
                             fora do menu e o submenu fecha a meio caminho -->
                        <Popup x:Name="PART_Popup" Placement="Right"
                               HorizontalOffset="0" VerticalOffset="-6"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource MenuBg}"
                                    BorderBrush="{StaticResource MenuEdge}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="0,5,0,5" MinWidth="150"
                                    SnapsToDevicePixels="True">
                                <ItemsPresenter/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{StaticResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{StaticResource MenuFg}"/>
        <!-- e isto que poe AllowsTransparency na popup do menu; a false, os cantos
             arredondados apareciam recortados contra um fundo opaco -->
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{StaticResource MenuBg}"
                            BorderBrush="{StaticResource MenuEdge}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="0,5,0,5" MinWidth="170"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ caixas de dialogo ============ -->

    <Style x:Key="DialogInput" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{StaticResource MenuFg}"/>
        <Setter Property="CaretBrush" Value="{StaticResource MenuFg}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="9,7,9,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Edge" Background="{StaticResource FieldBg}"
                            BorderBrush="{StaticResource FieldEdge}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource MenuFg}"/>
        <!-- o rectangulo pontilhado do wpf denuncia a idade do toolkit; o foco ja se ve
             pela borda a mudar de cor no template -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="6"
                            Background="Transparent"
                            BorderBrush="{StaticResource FieldEdge}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="14,0,14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{StaticResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogPrimary" TargetType="{x:Type Button}"
           BasedOn="{StaticResource DialogButton}">
        <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="6"
                            Background="{StaticResource Accent}"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="14,0,14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.86"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
